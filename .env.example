# PostgreSQL Connection Settings (Local DB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=daiict_db
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# AI Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI-compatible endpoint (optional) ---
# Point chat at any OpenAI-compatible server, e.g. a local vLLM instance.
# A local server needs no API key. Defaults: https://api.openai.com/v1 and gpt-4o-mini.
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen/Qwen3-8B
# Order providers are tried in. Default is gemini,openai.
# "openai,gemini" tries the OpenAI-compatible (local) model first.
# LLM_PROVIDER_ORDER=openai,gemini

# Library OPAC (Koha)
LIBRARY_OPAC_BASE_URL=https://opac.daiict.ac.in

# Email Configuration (Feedback System)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_sender_email@gmail.com
SMTP_PASSWORD=your_app_password
FEEDBACK_RECIPIENT_EMAILS=admin1@domain.com,admin2@domain.com
GOOGLE_CLIENT_ID=your-google-client-id